[Bb]uild/
bin/
out/

# IDEs
.vscode/
.vs/
*.swp
*.swo

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# Docs
# Doxyfile is committed at .config/doxygen/Doxyfile. Generated documentation output is ignored.
html/
latex/

# Checkpoints. Written into the working directory by the examples and by
# `sushiai train`, whose default output path is relative - so a run from the
# repository root leaves one here.
*.sushi

# CLI: machine-specific overrides, Python caches, and editable installs.
cli/config.local.toml
__pycache__/
*.pyc
cli/*.egg-info/
cli/.pytest_cache/
.sushi_env.json

# YOLO26 reference tensors: 35 MB, regenerated bit for bit by
# tools/reference/export_yolo26_reference.py into the fixture folders of their tests;
# tests/vision/registration/fixtures/yolo26/MANIFEST.json pins their hashes.
tests/**/fixtures/**/*.sacp

# Checkpoints a training run writes.
*.ckpt
docs/archive/

# Datasets the examples read; each is downloaded by hand.
/datasets/
