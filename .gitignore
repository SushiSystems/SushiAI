[Bb]uild/
bin/
out/

# IDEs
.vscode/
.vs/
*.swp
*.swo

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# Docs
# Doxyfile itself is COMMITTED - `sa doxygen` reads a repo-root one and fails
# without it, so ignoring it made the documented command impossible in a fresh
# checkout. Only its generated output is ignored.
docs/api-site/html/
docs/api-site/doxygen-warnings.log
html/
latex/

# Checkpoints. Written into the working directory by the examples and by
# `sushiai train`, whose default output path is relative - so a run from the
# repository root leaves one here.
*.ckpt

# CLI: machine-specific overrides, Python caches, and editable installs.
cli/config.local.toml
__pycache__/
*.pyc
cli/*.egg-info/
cli/.pytest_cache/
.sushi_env.json
