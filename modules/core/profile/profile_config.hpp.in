/**
 * @file profile_config.hpp.in
 * @brief Declares the profiler settings the build chose, for profile.hpp alone to read.
 * @author Mustafa Garip
 */

#pragma once

/// @brief 1 when SushiProfiler is linked and the SA_ZONE family records, 0 when it compiles away.
#define SA_ENABLE_PROFILER @SA_PROFILE_ENABLED_VALUE@

/// @brief The compile-time ceiling of the SA_ZONE family; 0 removes every site.
#define SA_PROFILE_LEVEL @SA_PROFILE_LEVEL@
